	b2f4e0c35c1e4b14881bf937d283a73a1f11ec23650298f0628ecf0c769ada581ffbf92efc718b1307f1ab4371f86027705d8bff7c8e427aee3850f28325d910  config-$_flavor.aarch64 \
	7cd29806591ca5521673a60cc60b30f742d9b8c5eaaf78d3f5c2fd84c889b5f757ba6a215a699bfbb0d93085164dfc866199921fb9551d9dd2667f6b28953c78  0001-arm64-dts-qcom-add-msm8953-samsung-c7lte.patch \
	951a9f8b309450b684d908e0e1617b0efc1bba897c132e1e92d693e342cd4e706512ec6b3b53510bcbccc43f5f9ea9b3927f3ac50477fd1359c6a9e5a2389888  panel-samsung-s6e3fa3.c \
