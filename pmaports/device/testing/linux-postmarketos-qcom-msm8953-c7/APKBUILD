# Kernel config based on: defconfig, msm8953.config, and device configs
#
# Samsung Galaxy C7 (SM-C7000 / c7lte) flavour of the community MSM8953
# kernel. Identical configuration, plus the C7 device tree (see the patch).
maintainer="nura-c7 <nura-c7@users.noreply.github.com>"
_flavor="postmarketos-qcom-msm8953-c7"
pkgname=linux-$_flavor
pkgver=7.1.3
pkgrel=1
pkgdesc="Mainline kernel for the Samsung Galaxy C7 (SM-C7000), MSM8953"
arch="aarch64"
_carch="arm64"
url="https://github.com/msm8953-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
"

_tag="$pkgver-r0"

source="
	$pkgname-v$_tag.tar.gz::$url/archive/v$_tag.tar.gz
	config-$_flavor.aarch64
	0001-arm64-dts-qcom-add-msm8953-samsung-c7lte.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config

	# Register the C7 DTS with kbuild. Appending is safe here: the qcom
	# Makefile is a flat list of "dtb-$(CONFIG_ARCH_QCOM) += ..." lines.
	# Doing it here instead of in the patch keeps the patch context-free
	# (it only adds a new file), so it does not rot with every rebase.
	echo 'dtb-$(CONFIG_ARCH_QCOM) += msm8953-samsung-c7lte.dtb' \
		>> arch/arm64/boot/dts/qcom/Makefile
}

build() {
	unset LDFLAGS
	# Build the DTBs first: a broken board file then fails in ~2 minutes
	# instead of after the whole kernel has compiled.
	make ARCH="$_carch" LLVM=1 dtbs

	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot

	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}
# NOTE: the tarball hash is the one pmaports ships for
# linux-postmarketos-qcom-msm8953-v7.1.3-r0: same URL, same bytes. CI runs
# "pmbootstrap checksum" anyway, so any drift is fixed automatically.
sha512sums="
a57d343c41065df0d41c7005aee07855e7d7aea592327f97c219d8109c10a60b08f54f494a132b4d1d3a549fb4dbffb523e8f49415c0905805f1332f4ddf2dcc  linux-postmarketos-qcom-msm8953-c7-v7.1.3-r0.tar.gz
c2c568d845442af1ca59e16eb19023e5d2436b6194ac05ddf4dc15159a82e42305ff45ba782b23ccfed5818d5a576e87519be3ef767a29a29114fbf0bc2dfb30  config-postmarketos-qcom-msm8953-c7.aarch64
0cf907af6135bbc284aac0bfbebacde03a338d10c4d1c29e5532d6da889dcc14626a23272651e7dfd929c1926f7da3928993ff1c27d396f36fd0ee933b8ceda1  0001-arm64-dts-qcom-add-msm8953-samsung-c7lte.patch
"
