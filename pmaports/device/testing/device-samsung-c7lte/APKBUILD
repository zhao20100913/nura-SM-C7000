# Reference: <https://postmarketos.org/devicepkg>
maintainer="nura-c7 <nura-c7@users.noreply.github.com>"
pkgname=device-samsung-c7lte
pkgver=0.1
pkgrel=12
pkgdesc="Samsung Galaxy C7 (SM-C7000)"
url="https://gitlab.nura.eco/nura/pmaports"
arch="aarch64"
license="MIT"
options="!check !archcheck"
depends="
	firmware-qcom-adreno-a530
	lk2nd-msm8953
	linux-postmarketos-qcom-msm8953-c7
	dtbtool
	mkbootimg
	mkbootimg-osm0sis
	msm-firmware-loader
	postmarketos-base
	soc-qcom-msm8953
	c7-pwrkey
	i2c-tools
	iw
	evtest
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	c7-diag
	kernel-cmdline.conf
	WCNSS_qcom_wlan_nv.bin
	10-wcnss.start
	10-c7-power.conf
	10-wcn36xx.conf
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	install -Dm755 "$srcdir"/c7-diag "$pkgdir"/usr/bin/c7-diag
	devicepkg_package "$startdir" "$pkgname"

	# The WLAN NV calibration blob is not on any partition: Samsung keeps it
	# inside system.img (/vendor/firmware/wlan/prima) and wcn36xx insists on
	# "wlan/prima/WCNSS_qcom_wlan_nv.bin" before it will download firmware.
	install -Dm644 "$srcdir"/WCNSS_qcom_wlan_nv.bin \
		"$pkgdir"/usr/lib/firmware/wlan/prima/WCNSS_qcom_wlan_nv.bin

	# Nothing in the pmOS rootfs starts the WCNSS remoteproc (it is not
	# auto-booted by the kernel), so hook into openrc's "local" service.
	install -Dm755 "$startdir"/10-wcnss.start \
		"$pkgdir"/etc/local.d/10-wcnss.start

	# elogind defaults to powering off on a short power-key press, which
	# looks exactly like a spontaneous reboot on this phone.
	install -Dm644 "$startdir"/10-c7-power.conf \
		"$pkgdir"/etc/elogind/logind.conf.d/10-c7-power.conf

	# wcn36xx + power save breaks the 4-way handshake on this WCN3680.
	install -Dm644 "$startdir"/10-wcn36xx.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/10-wcn36xx.conf
}

