#!/sbin/openrc-run
# Apply C7 wireless tuning after NetworkManager is up: unblock rfkill, set a
# real regulatory domain and keep power save off.
#
# country=00 leaves every 5 GHz channel passive ("no IR"), which makes 5 GHz
# association unusable.  CN opens 36-64 / 149-165.  "iw reg set CN" only works
# when the wireless-regdb package is installed (signed regulatory.db), so the
# failure path says so instead of silently staying at country 00.

description="Apply C7 wireless tuning: rfkill, regdomain, power save"

depend() {
	after networkmanager wpa_supplicant
}

start() {
	ebegin "Tuning wlan0 (rfkill/regdomain/power save)"
	i=0
	while [ "$i" -lt 30 ]; do
		[ -d /sys/class/net/wlan0 ] && break
		sleep 1
		i=$((i + 1))
	done

	rfkill unblock wifi >/dev/null 2>&1

	if ! iw reg set CN 2>/tmp/c7-reg.err; then
		ewarn "iw reg set CN failed: $(cat /tmp/c7-reg.err 2>/dev/null)"
		if [ ! -e /lib/firmware/regulatory.db ] &&
		   [ ! -e /usr/lib/firmware/regulatory.db ]; then
			ewarn "regulatory.db is missing (install wireless-regdb)"
		fi
	fi

	if [ -d /sys/class/net/wlan0 ]; then
		iw dev wlan0 set power_save off >/dev/null 2>&1
	fi
	eend 0
}
