#!/bin/sh
# c7-wifi SSID PASSWORD [--save] [--legacy]
#
# Drive wpa_supplicant directly, try several link variants and report where
# each one stops.  This is both the connect helper and the 4-way-handshake
# diagnostic for the C7 (wcn36xx/WCN3680):
#
#   variant   profile
#   ccmp      RSN, CCMP pairwise/group, HT/VHT as negotiated
#   no-ht     CCMP, HT40/VHT disabled (firmware-friendly BSS config)
#   tkip      CCMP+TKIP allowed (APs with a TKIP group cipher)
#
# For every variant it prints the EAPOL/M1/M2/M3/M4 counters from the real
# supplicant log.  --save writes an NM keyfile with psk-flags=0 and hands
# wlan0 back to NetworkManager when the ccmp variant is the one that works
# (NM cannot force the no-ht/tkip variants).
#
# --legacy skips the ccmp variant (starts with no-ht).
#
# Exit status: 0 = connected, 1 = failed.

set -u

usage() {
	echo "usage: c7-wifi SSID PASSWORD [--save] [--legacy]" >&2
	exit 2
}

[ $# -ge 2 ] || usage
ssid=$1
pass=$2
shift 2
save=0
legacy=0
for arg in "$@"; do
	case $arg in
	--save) save=1 ;;
	--legacy) legacy=1 ;;
	*) usage ;;
	esac
done

[ "$(id -u)" = 0 ] || { echo "c7-wifi: run as root" >&2; exit 1; }
[ -d /sys/class/net/wlan0 ] || {
	echo "c7-wifi: wlan0 does not exist; is the WCNSS remoteproc running?" >&2
	echo "  see: dmesg | grep -iE 'wcnss|wcn36'" >&2
	exit 1
}
case $ssid$pass in
*'"'* | *\\*)
	echo "c7-wifi: SSID or password contains a quote/backslash; unsupported" >&2
	exit 2
	;;
esac

conf=/run/c7-wpa.conf
log=/tmp/c7-wpa.log
debug=/sys/module/wcn36xx/parameters/debug_mask
oldmask=
wpa_pid=

say() { printf '%s\n' "$*"; }

count() {
	c=$(grep -c "$1" "$log" 2>/dev/null) || c=0
	echo "${c:-0}"
}

# wpa_supplicant 2.11 has no -f option (that is hostapd); run it in the
# foreground of a background job and redirect its log instead.
start_wpa() {
	killall wpa_supplicant 2>/dev/null || true
	sleep 1
	: > "$log"
	if command -v setsid >/dev/null 2>&1; then
		setsid wpa_supplicant -i wlan0 -D nl80211 -c "$conf" -dd \
			>"$log" 2>&1 &
	else
		wpa_supplicant -i wlan0 -D nl80211 -c "$conf" -dd \
			>"$log" 2>&1 &
	fi
	wpa_pid=$!
}

stop_wpa() {
	[ -n "$wpa_pid" ] || return 0
	kill "$wpa_pid" 2>/dev/null || true
	wait "$wpa_pid" 2>/dev/null || true
	killall wpa_supplicant 2>/dev/null || true
	wpa_pid=
}

write_conf() {
	extra=$1
	{
		echo 'network={'
		printf '\tssid="%s"\n' "$ssid"
		printf '\tpsk="%s"\n' "$pass"
		echo '	proto=RSN'
		echo '	key_mgmt=WPA-PSK'
		echo '	ieee80211w=0'
		[ -n "$extra" ] && printf '%s\n' "$extra"
		echo '}'
	} > "$conf"
	chmod 600 "$conf"
}

# $1 label, $2 extra config lines
attempt() {
	label=$1
	extra=$2

	write_conf "$extra"
	start_wpa

	connected=0
	i=0
	while [ "$i" -lt 20 ]; do
		if grep -q 'CTRL-EVENT-CONNECTED' "$log" 2>/dev/null; then
			connected=1
			break
		fi
		if [ "$i" -ge 6 ] &&
		   grep -q 'CTRL-EVENT-DISCONNECTED' "$log" 2>/dev/null; then
			break
		fi
		sleep 1
		i=$((i + 1))
	done

	eapol=$(count 'RX EAPOL from')
	m1=$(count 'RX message 1 of 4-Way')
	m2=$(count 'Sending EAPOL-Key 2/4')
	m3=$(count 'RX message 3 of 4-Way')
	m4=$(count 'Sending EAPOL-Key 4/4')
	reason=$(grep -o 'reason=[0-9]*' "$log" 2>/dev/null | tail -1)

	say "  [$label] EAPOL=$eapol M1=$m1 M2=$m2 M3=$m3 M4=$m4 $reason"

	if [ "$connected" = 1 ]; then
		return 0
	fi
	stop_wpa
	return 1
}

finish() {
	[ -n "$oldmask" ] && [ -w "$debug" ] &&
		echo "$oldmask" > "$debug" 2>/dev/null
}
trap finish EXIT
trap 'exit 1' INT TERM

# HAL/MAC debug gives the firmware's config_bss status (and key errors).
if [ -w "$debug" ]; then
	oldmask=$(cat "$debug" 2>/dev/null || echo 0)
	echo 0x500 > "$debug" 2>/dev/null || true
fi

rfkill unblock wifi 2>/dev/null || true
if ! iw reg set CN 2>/tmp/c7-reg.err; then
	say "note: iw reg set CN failed: $(cat /tmp/c7-reg.err 2>/dev/null)"
	if [ ! -e /lib/firmware/regulatory.db ] &&
	   [ ! -e /usr/lib/firmware/regulatory.db ]; then
		say "note: no regulatory.db; install the wireless-regdb package"
	fi
fi
say "regdomain: $(iw reg get 2>/dev/null | grep -m1 '^country' || echo 'country unknown')"

rc-service networkmanager stop >/dev/null 2>&1 || true
killall wpa_supplicant 2>/dev/null || true
i=0
while [ "$i" -lt 10 ] && pgrep -x wpa_supplicant >/dev/null 2>&1; do
	sleep 1
	i=$((i + 1))
done
iw dev wlan0 set power_save off 2>/dev/null || true
say "power save: $(iw dev wlan0 get power_save 2>/dev/null | sed 's/.*: //')"

ccmp='	pairwise=CCMP
	group=CCMP'
noht='	pairwise=CCMP
	group=CCMP
	disable_ht=1
	disable_ht40=1
	disable_vht=1'
tkip='	pairwise=CCMP TKIP
	group=CCMP TKIP'

say "== trying link variants for $ssid"
won=
if [ "$legacy" = 0 ] && attempt ccmp "$ccmp"; then
	won=ccmp
elif attempt no-ht "$noht"; then
	won=no-ht
elif attempt tkip "$tkip"; then
	won=tkip
fi

if [ -z "$won" ]; then
	say "---- handshake"
	say "EAPOL frames received : $(count 'RX EAPOL from')"
	say "M1 received           : $(count 'RX message 1 of 4-Way')"
	say "M2 sent               : $(count 'Sending EAPOL-Key 2/4')"
	say "M3 received           : $(count 'RX message 3 of 4-Way')"
	say "M4 sent               : $(count 'Sending EAPOL-Key 4/4')"
	say "reason                : $(grep -o 'reason=[0-9]*' "$log" 2>/dev/null | tail -1)"
	keyerr=$(dmesg 2>/dev/null |
		grep -iE 'config bss|config_bss|set_stakey|set_bsskey' | tail -8)
	[ -n "$keyerr" ] && { say "driver key/bss errors:"; say "$keyerr"; }
	say "---- verdict"
	if ! grep -q 'CTRL-EVENT' "$log" 2>/dev/null; then
		say "wpa_supplicant produced no control events - see $log"
	elif ! grep -q 'RX EAPOL from' "$log" 2>/dev/null; then
		say "No EAPOL frame reached the host (not a password problem)."
		say "Check the driver errors above; M1 is stuck in the firmware."
	else
		say "EAPOL reached the host but the handshake did not finish;"
		say "see the counters and driver errors above."
	fi
	say "full log: $log"
	exit 1
fi

say "connected with variant: $won"
iw dev wlan0 link
udhcpc -i wlan0 -q -n -t 10 >/dev/null 2>&1 || true
say "---- address"
ip -4 addr show wlan0 | sed -n 's/^ *inet /inet /p'

if [ "$save" = 1 ]; then
	if [ "$won" != "ccmp" ]; then
		say "note: NM cannot force '$won'; leaving the direct supplicant running."
		say "RESULT: connected (direct wpa_supplicant, $won)"
		exit 0
	fi
	name="c7-$(printf '%s' "$ssid" | tr -c 'A-Za-z0-9._-' '_')"
	path=/etc/NetworkManager/system-connections/$name.nmconnection
	mkdir -p /etc/NetworkManager/system-connections
	(
		umask 077
		{
			echo '[connection]'
			printf 'id=%s\n' "$name"
			printf 'uuid=%s\n' "$(cat /proc/sys/kernel/random/uuid)"
			echo 'type=wifi'
			echo 'interface-name=wlan0'
			echo 'autoconnect=true'
			echo 'autoconnect-priority=10'
			echo
			echo '[wifi]'
			echo 'mode=infrastructure'
			printf 'ssid=%s\n' "$ssid"
			echo 'powersave=2'
			echo
			echo '[wifi-security]'
			echo 'key-mgmt=wpa-psk'
			printf 'psk=%s\n' "$pass"
			echo 'psk-flags=0'
			echo
			echo '[ipv4]'
			echo 'method=auto'
			echo
			echo '[ipv6]'
			echo 'method=auto'
		} > "$path"
	)
	chmod 600 "$path"
	say "saved NM profile: $path"

	if ! command -v nmcli >/dev/null 2>&1; then
		say "NetworkManager is not installed; profile saved"
		exit 0
	fi
	stop_wpa
	rc-service networkmanager start >/dev/null 2>&1 || true
	i=0
	while [ "$i" -lt 30 ]; do
		case $(nmcli -g GENERAL.STATE dev show wlan0 2>/dev/null) in
		*connected*) break ;;
		esac
		sleep 1
		i=$((i + 1))
	done
	nmcli -f GENERAL.STATE,IP4.ADDRESS dev show wlan0 2>&1 || true
	case $(nmcli -g GENERAL.STATE dev show wlan0 2>/dev/null) in
	*connected*) say "RESULT: connected via NetworkManager"; exit 0 ;;
	esac
	say "RESULT: profile saved but NetworkManager did not connect"
	exit 1
fi

say "RESULT: connected (direct wpa_supplicant, NetworkManager stopped)"
exit 0
