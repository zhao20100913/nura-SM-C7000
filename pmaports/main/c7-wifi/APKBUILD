# Reference: <https://postmarketos.org/devicepkg>
maintainer="nura-c7 <nura-c7@users.noreply.github.com>"
pkgname=c7-wifi
pkgver=0.1
pkgrel=1
pkgdesc="Wireless tuning and NetworkManager-free connect helper for Galaxy C7"
url="https://github.com/zhao20100913/nura-SM-C7000"
arch="aarch64"
license="MIT"
options="!check"
# wireless-regdb: "iw reg set CN" needs the signed regulatory.db, otherwise
# the kernel stays at country=00 and every 5 GHz channel is no-IR.
# iproute2: the helper prints addresses with "ip".
depends="iw wpa_supplicant wireless-regdb iproute2"
source="
	c7-wifi-tune
	c7-wifi
	c7-wifi-nwmm
"

package() {
	install -Dm755 "$srcdir/c7-wifi-tune" "$pkgdir"/etc/init.d/c7-wifi-tune
	install -Dm755 "$srcdir/c7-wifi" "$pkgdir"/usr/bin/c7-wifi
	install -Dm755 "$srcdir/c7-wifi-nwmm" "$pkgdir"/usr/bin/c7-wifi-nwmm

	# v5 shipped the tuning script but never enabled it, so the regulatory
	# domain was never set at boot.
	mkdir -p "$pkgdir"/etc/runlevels/default
	ln -sf /etc/init.d/c7-wifi-tune "$pkgdir"/etc/runlevels/default/c7-wifi-tune
}

sha512sums="
