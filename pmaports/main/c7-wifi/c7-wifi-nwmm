#!/bin/sh
# Kept for compatibility with the v5 instructions.
#
# "wmm_enabled" is not a wpa_supplicant network option (it only exists in
# hostapd), so the v5 script never disabled WMM: wpa_supplicant logged
# "unknown network block field 'wmm_enabled'" and the test did nothing.
# A station cannot turn WMM off from userspace either, so this now runs the
# closest supported variant: HT/VHT/40 MHz disabled.
#
# If this still fails, the U-APSD theory was wrong and the verdict printed
# by c7-wifi is the useful next datum.

set -eu
echo "c7-wifi-nwmm: WMM cannot be disabled as a station; using HT/VHT off" >&2
exec /usr/bin/c7-wifi "$@" --legacy
