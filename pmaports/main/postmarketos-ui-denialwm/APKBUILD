# Reference: https://postmarketos.org/uipkg
maintainer="nura-c7 <nura-c7@users.noreply.github.com>"
#
# Nura's out-of-tree Denial UI.  Denial is a Flutter/Smithay compositor and
# its session script already sets up the user D-Bus, pipewire and the
# compositor hand-off, so greetd only has to exec it.
pkgname=postmarketos-ui-denialwm
pkgver=0.1
pkgrel=0
pkgdesc="(Wayland) Denial compositor, Flutter-native desktop shell"
url="https://denialwm.org/"
arch="noarch"
license="MIT"
options="!check pmb:drm pmb:default-openrc pmb:support-openrc"
replaces="greetd"
install="$pkgname.post-install"

depends="
	dbus
	denial
	elogind
	font-noto
	font-noto-cjk
	font-noto-emoji
	greetd
	greetd-openrc
	pipewire
	pipewire-pulse
	polkit-elogind
	postmarketos-base-ui
	postmarketos-base-ui-audio
	postmarketos-base-ui-networkmanager
	seatd
	wireplumber
	xdg-desktop-portal
	xdg-desktop-portal-gtk
	xdg-desktop-portal-wlr
	xwayland
"

source="
	greetd-config.toml
	$pkgname.post-install
"

package() {
	install -Dm644 "$srcdir"/greetd-config.toml \
		"$pkgdir"/etc/greetd/config.toml
}

