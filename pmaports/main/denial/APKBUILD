# Adapted from denialwm/denial packaging/alpine/APKBUILD for aarch64.
#
# Upstream only publishes an x86_64 Alpine APK, but the package is just the
# official glibc arm64 payload plus a musl compatibility layer: gcompat, an
# RPATH pointing at the bridge directory, and two small shim libraries that
# supply the resolver and pthread stack the Flutter engine expects.  The same
# adapter therefore works unchanged on aarch64.
pkgname=denial
pkgver=0.6.8
pkgrel=0
pkgdesc="Flutter-native Wayland compositor and desktop shell"
url="https://github.com/denialwm/denial"
arch="aarch64"
license="GPL-3.0-or-later AND Apache-2.0 AND CC-BY-SA-4.0 AND GPL-3.0-only AND OFL-1.1"
options="!check !strip !tracedeps"
builddir="$srcdir"
install="$pkgname.post-install $pkgname.pre-deinstall"

depends="
	git
	bash
	coreutils
	dbus
	dbus-x11
	elogind
	eudev-libs
	fontconfig
	font-noto
	font-noto-cjk
	font-noto-emoji
	gcompat
	libgcc
	libinput
	libpulse
	libseat
	libxkbcommon
	mesa-dri-gallium
	mesa-egl
	mesa-gbm
	mesa-gles
	openrc
	pipewire
	pipewire-pulse
	polkit-elogind
	rtkit
	seatd
	vulkan-loader
	wayland-libs-client
	wireplumber
	xdg-desktop-portal
	xdg-desktop-portal-gtk
	xdg-desktop-portal-wlr
	xkeyboard-config
	xwayland
"

makedepends="binutils gcc musl-dev patchelf"

source="
	https://github.com/denialwm/denial/releases/download/v$pkgver/denial_${pkgver}-1_arm64.deb
	https://github.com/denialwm/denial/releases/download/v$pkgver/denial-flutter-engine_${pkgver}-1_arm64.deb
	denial-alpine-session
	denial.desktop
	denial-runtime-dirs
	denial.post-install
	denial.pre-deinstall
	denial-pthread-stack.c
	denial-resolver-bridge.c
"

build() {
	# musl shims loaded through the ELF metadata of the glibc binaries
	cc $CFLAGS $LDFLAGS -fPIC -shared \
		-Wl,-soname,libdenial-resolver-bridge.so.0 \
		-o libdenial-resolver-bridge.so.0 \
		"$srcdir/denial-resolver-bridge.c"
	cc $CFLAGS $LDFLAGS -fPIC -shared \
		-Wl,-soname,libdenial-pthread-stack.so.0 \
		-o libdenial-pthread-stack.so.0 \
		"$srcdir/denial-pthread-stack.c" -pthread

	mkdir -p unpack
	for deb in "$srcdir"/denial_*.deb "$srcdir"/denial-flutter-engine_*.deb; do
		base=$(basename "$deb" .deb)
		mkdir -p "unpack/$base"
		(cd "unpack/$base" && ar x "$deb" && tar -xf data.tar.*)
	done
}

package() {
	install -d "$pkgdir"
	for tree in unpack/*; do
		cp -a --no-preserve=ownership "$tree/." "$pkgdir/"
	done

	# The payload ships a bash path from a glibc distribution.
	sed -i '1s|^#!/usr/bin/bash$|#!/usr/bin/env bash|' \
		"$pkgdir/usr/bin/denial-session"

	install -Dm755 "$srcdir/denial-alpine-session" \
		"$pkgdir/usr/bin/denial-alpine-session"
	install -Dm755 "$srcdir/denial-runtime-dirs" \
		"$pkgdir/etc/init.d/denial-runtime-dirs"
	install -Dm644 "$srcdir/denial.desktop" \
		"$pkgdir/usr/share/wayland-sessions/denial.desktop"
	install -Dm755 libdenial-resolver-bridge.so.0 \
		"$pkgdir/usr/lib/denial/alpine/libdenial-resolver-bridge.so.0"
	install -Dm755 libdenial-pthread-stack.so.0 \
		"$pkgdir/usr/lib/denial/alpine/libdenial-pthread-stack.so.0"

	patchelf --set-rpath /usr/lib/denial/alpine \
		--add-needed libgcompat.so.0 \
		--add-needed libdenial-resolver-bridge.so.0 \
		--add-needed libdenial-pthread-stack.so.0 \
		"$pkgdir/usr/bin/deniald"
	patchelf --set-rpath /usr/lib/denial/alpine \
		--add-needed libgcompat.so.0 \
		--add-needed libdenial-resolver-bridge.so.0 \
		--add-needed libdenial-pthread-stack.so.0 \
		"$pkgdir/usr/bin/denial-portal"
	patchelf --set-rpath /usr/lib/denial/alpine \
		--add-needed libgcompat.so.0 \
		--add-needed libdenial-resolver-bridge.so.0 \
		--add-needed libdenial-pthread-stack.so.0 \
		"$pkgdir/usr/lib/denial-apps/settings"
	patchelf --set-rpath /usr/lib/denial/alpine \
		--add-needed libgcompat.so.0 \
		"$pkgdir/usr/lib/denial-apps/wifi-country"

	# systemd-only hand-off units; the session script owns the lifecycle here.
	rm -f "$pkgdir"/usr/lib/systemd/user/denial-session.target \
		"$pkgdir"/usr/lib/systemd/user/denial-portal.service
	rmdir -p --ignore-fail-on-non-empty "$pkgdir/usr/lib/systemd/user" 2>/dev/null || true
}

