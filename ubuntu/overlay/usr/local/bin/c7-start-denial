#!/bin/sh
# Start the Denial session on /dev/tty1 (see ../home/c7/.bash_profile).
# DIAGNOSTIC BUILD: on failure this dumps the reason to the console so a
# single photo shows the exact error, then drops to a plain shell instead of
# silently falling back to Phosh.
set -u

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Denial
export XDG_CURRENT_DESKTOP=Denial
export LIBSEAT_BACKEND=logind
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/denial"
mkdir -p "$state_dir"
chmod 0700 "$state_dir"
log="$state_dir/ubuntu-session.log"
exec >>"$log" 2>&1

printf '\n=== Ubuntu Denial DIAG session %s ===\n' "$(date -Iseconds)"
echo "uid=$(id -u) tty=$(tty 2>/dev/null || echo none) HOME=$HOME"
echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
echo "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS"

diag() {
	# append hardware/system facts, then show the whole picture on screen
	{
		echo "===== cmdline ====="
		cat /proc/cmdline 2>&1
		echo
		echo "===== /dev/dri ====="
		ls -l /dev/dri 2>&1
		echo "===== /sys/class/drm ====="
		ls -l /sys/class/drm 2>&1
		echo "===== msm/gpu modules ====="
		lsmod 2>/dev/null | grep -Ei 'msm|a5xx|adreno|gpu|freedreno|kgsl' || echo "(none)"
		echo "===== drm/gpu dmesg ====="
		dmesg 2>/dev/null | grep -Ei 'drm|msm|a5xx|adreno|firmware|gpu|freedreno' | tail -30
		echo "===== loginctl sessions ====="
		loginctl list-sessions 2>&1
		echo "===== user systemd ====="
		systemctl --user is-system-running 2>&1
	} >>"$log" 2>&1
	echo "===== FAILURE LOG TAIL ====="
	tail -70 "$log" > /dev/tty1 2>/dev/null || true
	tail -70 "$log" > /dev/console 2>/dev/null || true
}

if ! command -v denial-session >/dev/null 2>&1; then
	echo "c7-start-denial: denial-session NOT INSTALLED"
	echo "ls /usr/bin/denial*:"; ls -l /usr/bin/denial* /usr/libexec/denial* 2>&1
	diag
	exec bash -l
fi

ls -l /dev/dri 2>&1
ls -l "$XDG_RUNTIME_DIR" 2>&1 | head -20
timeout 5 loginctl session-status 2>&1 | head -25
timeout 5 systemctl --user is-system-running 2>&1
echo "===== denial-session --check ====="
timeout 20 /usr/bin/denial-session --check 2>&1 || echo "(--check rc=$?)"

if [ ! -e /dev/dri/card0 ]; then
	echo "c7-start-denial: no /dev/dri/card0; panel/DRM did not bind" >&2
	diag
	exec bash -l
fi

run_denial() {
	mode=$1
	if [ "$mode" = "dbus" ]; then
		dbus-run-session -- /usr/bin/denial-session --start-locked &
	else
		/usr/bin/denial-session --start-locked &
	fi
	pid=$!
	i=0
	while [ "$i" -lt 25 ]; do
		if ! kill -0 "$pid" 2>/dev/null; then
			wait "$pid"
			rc=$?
			echo "$mode: exited rc=$rc after ${i}s"
			return "$rc"
		fi
		if ls "$XDG_RUNTIME_DIR"/wayland-* >/dev/null 2>&1; then
			echo "$mode: wayland socket up after ${i}s"
			wait "$pid"
			rc=$?
			echo "$mode: exited rc=$rc"
			return "$rc"
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "$mode: no wayland socket after 25s, killing pid $pid"
	kill "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true
	return 124
}

echo "c7-start-denial: starting denial-session --start-locked"
run_denial direct
rc=$?
if [ "$rc" -ne 0 ]; then
	echo "c7-start-denial: retrying with dbus-run-session"
	run_denial dbus
	rc=$?
fi
if [ "$rc" -eq 0 ]; then
	exit 0
fi

echo "c7-start-denial: Denial failed (rc=$rc), showing diagnostics"
diag
exec bash -l
