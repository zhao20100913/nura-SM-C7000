# Android fstab file (TWRP style) for Samsung Galaxy C7 (SM-C7000)
#
# mount point       fstype      device                                              [device2]
/system             ext4        /dev/block/platform/soc/7824900.sdhci/by-name/system
/cache              ext4        /dev/block/platform/soc/7824900.sdhci/by-name/cache
/data               ext4        /dev/block/platform/soc/7824900.sdhci/by-name/userdata
/boot               emmc        /dev/block/platform/soc/7824900.sdhci/by-name/boot
/recovery           emmc        /dev/block/platform/soc/7824900.sdhci/by-name/recovery
/misc               emmc        /dev/block/platform/soc/7824900.sdhci/by-name/misc
/efs                ext4        /dev/block/platform/soc/7824900.sdhci/by-name/efs
/persist            ext4        /dev/block/platform/soc/7824900.sdhci/by-name/persist
/firmware           vfat        /dev/block/platform/soc/7824900.sdhci/by-name/apnhlos
/modem              vfat        /dev/block/platform/soc/7824900.sdhci/by-name/modem
/external_sd        vfat        /dev/block/mmcblk1p1                                /dev/block/mmcblk1
/usb_otg            vfat        /dev/block/sda1                                     /dev/block/sda
